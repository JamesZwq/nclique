\texttt{com-dblp}~\cite{communityFinder}        & $317{,}080$    & $1{,}049{,}866$   & $[2,110]$ & $109$ \\
\texttt{twitter}~\cite{communityFinder}         & $\phantom{0,0}81{,}306$ & $1{,}342{,}296$ & $[2,30]$ & $29$ \\
