%===============================================================
\section{Preliminaries}
\label{sec:prelim}

\subsection{Problem definition}
\label{sec:prelim-def}

Let $G = (V, E)$ be an undirected simple graph with $n = |V|$ vertices and $m = |E|$ edges. An $s$-clique is a set $C \subseteq V$ of size $s$ such that every pair of vertices in $C$ is connected by an edge. For integers $0 < r < s$, the \textit{$s$-support} of an $r$-clique $R$ is the number of distinct $s$-cliques in $G$ that contain $R$ as a subset; we write $\supp(R; G)$ for this count, and $\supp(v;G)$ when $r{=}1$ and the $r$-clique is a single vertex $v$. For a vertex set $S \subseteq V$, $G[S]$ denotes the subgraph induced on $S$.

\begin{definition}[$(1,s)$-nucleus decomposition]
\label{def:nd}
Given a graph $G$ and an integer $s \ge 2$, $S \subseteq V$ is a \textit{$(1,s)$-core} of level $k$ if every $v \in S$ satisfies $\supp(v; G[S]) \ge k$. The $(1,s)$-core number of $v$, denoted $\cores(v)$, is the largest $k$ for which $v$ belongs to some $(1,s)$-core of level $k$. The $(1,s)$-nucleus decomposition of $G$ is the mapping $v \mapsto \cores(v)$.
\end{definition}

\begin{example}
\label{ex:running}
Figure~\ref{fig:overview}(a) shows the running example $G$ used throughout the paper: a $10$-vertex graph consisting of two $K_4$ blocks on $\{v_1,v_2,v_3,v_4\}$ and $\{v_3,v_4,v_5,v_6\}$ that share the edge $(v_3,v_4)$, plus two pendant triangles $\{v_6,v_7,v_8\}$ and $\{v_2,v_9,v_{10}\}$. At $s{=}3$, the graph contains exactly $10$ triangles. The output (Figure~\ref{fig:overview}(c)) assigns core value $3$ to the six $K_4$-block vertices --- each of which lies in a subgraph where every vertex sees three triangles --- and core value $1$ to the four pendant vertices.
\end{example}

\subsection{The Clique Path Index}
\label{sec:prelim-cpi}

Explicit $s$-clique enumeration is infeasible at the scale of interest, since the number of $s$-cliques can exceed $m$ by many orders of magnitude and grows super-exponentially with $s$. The \textit{Clique Path Index} (\cpi)~\cite{sigmodCPI} avoids enumeration by encoding batches of $s$-cliques symbolically.

\begin{definition}[\cpi{} leaf]
\label{def:leaf}
A \cpi{} leaf is a pair $P = (\holdN{P}, \pivN{P})$ of disjoint vertex sets such that $\holdN{P} \cup \pivN{P}$ is a clique in $G$ and $|\holdN{P}| \le s \le |\holdN{P}| + |\pivN{P}|$. Vertices in $\holdN{P}$ are called \textit{hold} vertices and those in $\pivN{P}$ are called \textit{pivot} vertices. The leaf $P$ encodes every $s$-clique of the form $\holdN{P} \cup P'$ with $P' \subseteq \pivN{P}$ and $|P'| = s - |\holdN{P}|$. The number of encoded cliques is $\binom{|\pivN{P}|}{\eta_P}$, where $\eta_P := s - |\holdN{P}|$ is the \textit{target size} of $P$.
\end{definition}

A \cpi{} for $G$ at parameter $s$ is a set $\mathcal{P}$ of leaves such that every $s$-clique of $G$ is encoded by exactly one leaf. The existence of such a set is guaranteed by the \textit{succinct degeneracy clique tree} (\sdct) construction~\cite{sigmodCPI}, a degeneracy-ordered Bron--Kerbosch enumeration~\cite{bronkerbosch,eppstein} that uses Tomita pivoting~\cite{tomita} to compress sibling $s$-cliques into a single leaf. The \sdct{} is treated as a black box in this section and revisited in \S\ref{sec:treefree}.

\begin{example}
\label{ex:cpi}
Figure~\ref{fig:overview}(b) shows the \cpi{} produced by the \sdct{} for the graph of Example~\ref{ex:running} at $s{=}3$. It has six leaves: $L_1{=}(\{v_7\},\{v_6,v_8\})$ and $L_2{=}(\{v_9\},\{v_2,v_{10}\})$ encode the two pendant triangles, contributing $\binom{2}{2}{=}1$ clique each; $L_3{=}(\{v_1\},\{v_2,v_3,v_4\})$ encodes the three triangles of Block~A containing $v_1$, contributing $\binom{3}{2}{=}3$; $L_4{=}(\{v_2\},\{v_3,v_4\})$ encodes the remaining triangle of Block~A, contributing $\binom{2}{2}{=}1$; $L_5{=}(\{v_3\},\{v_4,v_5,v_6\})$ and $L_6{=}(\{v_4\},\{v_5,v_6\})$ play the symmetric role for Block~B. The total $1+1+3+1+3+1=10$ matches the triangle count of $G$.
\end{example}

The \cpi{} has two natural size measures. The first is the number of leaves $L = |\mathcal{P}|$. The second, on which all subsequent complexity bounds are stated, is the total \textit{vertex--leaf incidence count}
$
\Sig \,:=\, \sum_{P \in \mathcal{P}} (|\holdN{P}| + |\pivN{P}|),
$
which bounds both the \cpi{}'s space and the peel-time work. On the running example $\Sig = 3+3+4+3+4+3 = 20$; on real graphs $\Sig$ is typically $10^2$ to $10^4$ times $m$ at moderate $s$~\cite{sigmodCPI}. We further define the \textit{leaf degree} of a vertex,
$
\deg_{\Sig}(v) \,:=\, |\{P \in \mathcal{P} : v \in \holdN{P} \cup \pivN{P}\}|,
$
satisfying $\sum_v \deg_{\Sig}(v) = \Sig$, with $d_{\max} := \max_v \deg_{\Sig}(v)$ its maximum value. The maximum support
$
\kappa_{\max} \,:=\, \max_v \supp(v; G)
$
upper-bounds the largest bin index occupied during peeling (\S\ref{sec:bucket}); $\cores(v) \le \supp(v;G) \le \kappa_{\max}$ for every $v$. On the running example $d_{\max}=3$ (attained at $v_3$, which appears in $L_3$, $L_4$, $L_5$) and $\kappa_{\max}=6$.

The leaf representation translates directly into a closed-form support formula by counting, for each leaf containing $v$, how many of its encoded cliques contain $v$.

\begin{lemma}[\cpi{} support formula~\cite{sigmodCPI}]
\label{lem:supp}
For every vertex $v \in V$,
\[
  \supp(v; G) \;=\; \sum_{\substack{P \in \mathcal{P} \\ v \in \holdN{P}}} \binom{|\pivN{P}|}{\eta_P} \;+\; \sum_{\substack{P \in \mathcal{P} \\ v \in \pivN{P}}} \binom{|\pivN{P}|-1}{\eta_P-1}.
\]
\end{lemma}

\begin{example}
On the running example $v_3$ appears as a hold vertex of $L_5$ (contribution $\binom{3}{2}=3$), as a pivot of $L_4$ ($\binom{1}{1}=1$), and as a pivot of $L_3$ ($\binom{2}{1}=2$). Summing yields $\supp(v_3;G)=6$, consistent with the six triangles incident to $v_3$ in $G$.
\end{example}

\subsection{Peeling loop and its bottlenecks}
\label{sec:prelim-peel}

Vertex core numbers are computed by a classical peeling loop~\cite{coreAlg,sigmodCPI}. A priority queue over vertices is keyed by current $s$-support; at each step the vertex $v$ of minimum support is popped, its core value $\cores(v)$ is set to the current level $k$ (advanced to the queue's minimum whenever it exceeds $k$), and $v$ is removed from the graph. The removal changes the supports of surviving vertices and triggers updates in the queue.

With the \cpi{} in place, the update after peeling $v$ is localised to the leaves containing $v$, and three outcomes are possible per affected leaf $P$.

\sstitle{Case A.} $v \in \holdN{P}$. Every encoded clique contains $v$, so all of $\binom{|\pivN{P}|}{\eta_P}$ cliques die and $P$ is marked dead. On the running example, peeling $v_1$ kills $L_3=(\{v_1\},\{v_2,v_3,v_4\})$.

\sstitle{Case C.} $v \in \pivN{P}$ and $|\pivN{P}|-1 \ge \eta_P$. The leaf survives but its encoded count drops to $\binom{|\pivN{P}|-1}{\eta_P}$; pivots and holds lose support by binomial differences. On the running example, peeling $v_2$ from $L_3$ shrinks $|\pivN{L_3}|$ from $3$ to $2$ while $\eta_{L_3}{=}2$ still holds.

\sstitle{Case C$'$.} $v \in \pivN{P}$ and $|\pivN{P}|-1 < \eta_P$. The leaf no longer has enough pivots and dies. On the running example, peeling $v_8$ from $L_1$ shrinks $|\pivN{L_1}|$ from $2$ to $1 < \eta_{L_1}{=}2$.

The state-of-the-art implementation~\cite{sigmodCPI} represents $\mathcal{P}$ as a \textit{mutable} tree $\mathsf{T}$ and maintains a per-leaf vertex hash set $\mathsf{H}$ together with a binary heap $\mathsf{Q}$ over vertices. Each peeling step performs three operations per incident leaf: a hash erase on $\mathsf{H}$, a physical deletion in $\mathsf{T}$ (Case A or C$'$), and a $\Theta(\log n)$ decrease-key on $\mathsf{Q}$ for every surviving vertex whose support changes. Across the peel each incidence is touched at most twice, yielding total time $O(\Sig\log n)$~\cite{sigmodCPI}. Memory is dominated by $\mathsf{H}$ at $\sim 80$ bytes per incidence (hash node plus load-factor slack) and by $\mathsf{T}$ at $8$ bytes per incidence; the heap $\mathsf{Q}$ adds $24$ bytes per active vertex but is per-$n$, not per-$\Sig$. The mutability of $\mathsf{T}$ is structurally needed for $r{\ge}2$ peeling but, as the next section shows, is unnecessary for $r{=}1$.

%===============================================================
\section{The CPI Immutability Theorem}
\label{sec:immutable}

This section establishes the central observation of the paper: for $r{=}1$, peeling does not require any edits to the stored \cpi{} structure. The state of every leaf reduces to three integers, and every support update is a closed-form binomial difference. Theorem~\ref{thm:immutable} formalises the structural invariant; Lemma~\ref{lem:delta} formalises the corresponding update rule. Together they enable the local algorithm of \S\ref{sec:local}, the augmented \sdct{} construction of \S\ref{sec:treefree}, and the centralised peel of \S\ref{sec:peel}.

\subsection{Invariance of the CPI structure}
\label{sec:immutable-thm}

\begin{theorem}[\cpi{} immutability for $r{=}1$]
\label{thm:immutable}
Let $\mathcal{P}$ be a \cpi{} for $G$ at parameter $s$ and let $v \in V$ be a vertex peeled from $G$. A valid \cpi{} for $G - v$ at the same $s$ is obtained from $\mathcal{P}$ by the following \textit{counter-only} update, performed independently for each leaf $P \in \mathcal{P}$:
\begin{enumerate}[leftmargin=1.5em,itemsep=1pt,topsep=2pt]
  \item if $v \in \holdN{P}$, mark $P$ dead;
  \item else if $v \in \pivN{P}$, decrement $p_P := |\pivN{P}|$ by $1$, and mark $P$ dead if $p_P < \eta_P$;
  \item otherwise, leave $P$ unchanged.
\end{enumerate}
The stored sets $(\holdN{P}, \pivN{P})$ are never modified; no leaf is created, deleted, split, merged, or reattached.
\end{theorem}

\begin{proof}
Leaf $P$ encodes $\mathcal{C}(P) = \{\holdN{P} \cup P' : P' \subseteq \pivN{P},\ |P'| = \eta_P\}$ (Definition~\ref{def:leaf}). Removing $v$ from $G$ deletes from $\mathcal{C}(P)$ exactly the cliques that contain $v$. Three cases arise.

(i) If $v \in \holdN{P}$, every encoded clique contains $v$, hence $\mathcal{C}(P) = \emptyset$ in $G - v$ and the leaf is dead.
(ii) If $v \in \pivN{P}$, the cliques deleted are $\{\holdN{P} \cup P' : v \in P'\}$, and the surviving set $\{\holdN{P} \cup P' : P' \subseteq \pivN{P} \setminus \{v\},\, |P'| = \eta_P\}$ equals the set encoded by $(\holdN{P}, \pivN{P} \setminus \{v\})$. Tracking only the integer $p_P - 1$ encodes the same set, since the binomial enumeration depends only on the cardinality of the pivot universe; the leaf is dead iff $p_P - 1 < \eta_P$.
(iii) If $v \notin \holdN{P} \cup \pivN{P}$, no encoded clique contains $v$ and $\mathcal{C}(P)$ is unchanged.

In every case the stored $(\holdN{P}, \pivN{P})$ remains a valid encoding of the residual cliques in $G - v$. By induction over the peeling sequence, $\mathcal{P}$ stays valid throughout. \qed
\end{proof}

The structural reason behind Theorem~\ref{thm:immutable} is that vertex deletion is a \textit{cardinality} change to a leaf's pivot universe, which the binomial enumeration absorbs without re-pivoting. For $r \ge 2$, peeling an $r$-clique $R$ deletes edges in $G$, and a leaf whose pivot set straddles a deleted edge encodes cliques that are no longer cliques: the encoding is no longer faithful unless the leaf is split or re-pivoted. The single-integer invariant of Theorem~\ref{thm:immutable} is therefore tied specifically to $r{=}1$.

\subsection{Closed-form support deltas}
\label{sec:immutable-delta}

The structural invariant immediately yields a closed-form rule for the support updates triggered by a single peeling event. Suppose a leaf $P$ has its effective pivot count drop by $d \ge 1$ (or the leaf dies entirely in Case A / C$'$). The change in any surviving incident vertex's support, restricted to its contribution from $P$, is given by the following binomial difference.

\begin{lemma}[Counter-based support delta]
\label{lem:delta}
Let $P$ be a leaf with effective pivot count $p \ge \eta_P$ before a peeling event that removes $d \ge 1$ pivots from $P$. For every alive incident vertex $u$ that is not itself peeled, the change in $\supp(u; G)$ contributed by $P$ is
\begin{align*}
\Delta_{\mathrm{hold}}(p, \eta, d) &= \tbinom{p}{\eta} - \tbinom{p - d}{\eta}, & \text{if } u \in \holdN{P}, \\
\Delta_{\mathrm{pivot}}(p, \eta, d) &= \tbinom{p-1}{\eta - 1} - \tbinom{p - d - 1}{\eta - 1}, & \text{if } u \in \pivN{P}.
\end{align*}
Case~A is recovered as the special case $d = p$, giving $\Delta_{\mathrm{hold}} = \binom{p}{\eta}$ and $\Delta_{\mathrm{pivot}} = \binom{p-1}{\eta-1}$; Case~C$'$ kills the leaf with $p - 1 < \eta$ and the surviving vertices lose the same full-contribution amounts.
\end{lemma}

\begin{proof}
Apply Lemma~\ref{lem:supp} before and after the event. A hold vertex $u \in \holdN{P}$ contributes $\binom{p}{\eta}$ to $\supp(u)$ before and $\binom{p-d}{\eta}$ after; a pivot $u \in \pivN{P}$ contributes $\binom{p-1}{\eta-1}$ before (the $-1$ excludes $u$ itself from the pivot universe) and $\binom{p-d-1}{\eta-1}$ after. The deltas are the differences. \qed
\end{proof}

\begin{example}
\label{ex:peel}
Figure~\ref{fig:peel} traces the full peeling sequence on the running example. Round $5$ illustrates Case~C: $v_2$ is peeled, acting as a pivot of $L_3 = (\{v_1\},\{v_2,v_3,v_4\})$ with $p{=}3$, $\eta{=}2$, $d{=}1$. By Lemma~\ref{lem:delta}, the surviving hold vertex $v_1$ loses $\Delta_{\mathrm{hold}} = \binom{3}{2}-\binom{2}{2} = 2$ units, and the surviving pivots $v_3, v_4$ each lose $\Delta_{\mathrm{pivot}} = \binom{2}{1}-\binom{1}{1} = 1$ unit. The pivot set $\pivN{L_3}$ remains $\{v_2,v_3,v_4\}$ in memory; only the integer $p_{L_3}$ changes from $3$ to $2$.
\end{example}

\begin{figure*}[t]
\centering
\includegraphics[width=\linewidth]{figures/fig2_peeling.pdf}
\caption{Immutable-\cpi{} peeling trace and counter-based delta on the running example. \textbf{(a)}~Per-round, per-leaf state matrix. Round~$r$'s row shows the popped vertex, its assigned core value $\kappa$, and the event triggered on every \cpi{} leaf: Case~A (red) marks a hold removal, Case~C (green) a pivot shrink with the leaf still alive, Case~C$'$ (orange) a pivot removal that kills the leaf, and ``$-$'' (grey) means the leaf was already dead and is skipped. The annotated $\Delta_h$ and $\Delta_p$ are the support deltas of Lemma~\ref{lem:delta}, applied as $O(1)$ integer updates broadcast to alive incident vertices. \textbf{(b)}~Round~$5$ in detail: peeling $v_2$ from $L_3$ is a Case~C event in which only the integer $p_{L_3}$ changes; no pivot is physically removed and no hash is touched.}
\label{fig:peel}
\end{figure*}

Theorem~\ref{thm:immutable} and Lemma~\ref{lem:delta} reduce the dynamics of $(1,s)$-decomposition to integer arithmetic on three quantities per leaf: the effective pivot count $p_P$, the target size $\eta_P$, and a liveness flag. Two algorithms instantiate this state representation, distinguished by which entity initiates the support update. Section~\ref{sec:local} develops a vertex-initiated, decentralised iteration based on H-index convergence: each vertex independently recomputes its core value from its leaf-mates' values, with no global ordering and no shared queue. Section~\ref{sec:peel}, after the construction-side optimisation of Section~\ref{sec:treefree}, develops an order-initiated, centralised peel that runs in $O(\Sig)$ on a single thread. Both compute the same output (Lemma~\ref{lem:hindex-fixedpt}); they differ only in how they consume the invariant.

%===============================================================
\section{Local-Iterative Algorithm}
\label{sec:local}

The first algorithm exposed by Theorem~\ref{thm:immutable} is a local, vertex-initiated iteration. Each vertex independently recomputes its core value from its leaf-mates' current values, and the per-vertex update is closed-form via the \cpi{}'s leaf binomials. Within a single iteration no two vertices interact, so the algorithm parallelises trivially across cores, partitions cleanly across machines, and admits an external-memory implementation. \S\ref{sec:local-hindex} formulates the iteration as an H-index fixed-point characterisation of the $(1,s)$-core; \S\ref{sec:local-cpi} shows how the per-vertex H-index is computed from the \cpi{} without enumerating cliques; \S\ref{sec:local-cost} bounds the running time and contrasts the operating points of this algorithm and the centralised peel of \S\ref{sec:peel}.

\subsection{H-index reformulation of the $(1,s)$-core}
\label{sec:local-hindex}

For a multiset $M$ of non-negative integers, the \textit{H-index}~\cite{hindex} is $h(M) := \max\{k \in \mathbb{Z}_{\ge 0} : |\{x \in M : x \ge k\}| \ge k\}$. Montresor et~al.~\cite{kcoreLocal} characterised the $k$-core ($s{=}2$) as the fixed point of an iteration in which each vertex's value is the H-index of its neighbours' values; \cite{lu2016hcore} sharpened the result structurally. The same characterisation extends to $(1,s)$-cores for arbitrary $s$ by replacing the neighbour multiset with one minimum per incident $s$-clique.

\begin{definition}[Clique-min multiset]
\label{def:cmin}
For a vertex $v \in V$ and a candidate vector $\mathbf{c} \in \mathbb{Z}_{\ge 0}^V$, define
\[
  M_v(\mathbf{c}) \;:=\; \bigl\{\!\!\bigl\{\, \min_{u \in C \setminus \{v\}} \mathbf{c}[u] \,\bigm|\, C\text{ is an $s$-clique of $G$ with } v \in C \,\bigr\}\!\!\bigr\}.
\]
That is, for each $s$-clique containing $v$, take the smallest candidate value among the other vertices, and collect these values as a multiset (with multiplicity).
\end{definition}

\begin{lemma}[H-index fixed point characterizes $(1,s)$-core]
\label{lem:hindex-fixedpt}
For every $\mathbf{c}^{(0)} \in \mathbb{Z}_{\ge 0}^V$ with $\mathbf{c}^{(0)}[v] \ge \cores(v)$ for all $v$, the iteration
\[
  \mathbf{c}^{(t+1)}[v] \;=\; h\!\left(M_v(\mathbf{c}^{(t)})\right), \quad t = 0, 1, 2, \ldots
\]
converges to the $(1,s)$-core values $\cores$ in at most $\max_v \cores(v) + 1 \le \kappa_{\max} + 1$ rounds, where $\kappa_{\max}$ is the maximum support defined in \S\ref{sec:prelim-cpi}. The iteration is monotone non-increasing: $\mathbf{c}^{(t+1)} \le \mathbf{c}^{(t)}$ pointwise.
\end{lemma}

\begin{proof}[Proof sketch]
The H-index update is the level-$k$ subgraph membership witness: $\mathbf{c}^{(t+1)}[v] \ge k$ holds iff $v$ has at least $k$ $s$-cliques in which every other vertex has $\mathbf{c}^{(t)} \ge k$. The set $S^{(t)}_k := \{u : \mathbf{c}^{(t)}[u] \ge k\}$ is therefore a level-$k$ candidate; $S^{(t+1)}_k \subseteq S^{(t)}_k$ because thresholds can only fail more often as values shrink. The fixed point $\mathbf{c}^\star$ satisfies $\mathbf{c}^\star[v] \ge k \Leftrightarrow v$ in level-$k$ subgraph, which is exactly the definition of $\cores(v)$. Each iteration that fails to converge decreases at least one vertex's value by at least $1$, and values are non-negative integers, so $\le \kappa_{\max} + 1$ iterations suffice. The initial-bound condition guarantees $\mathbf{c}^{(0)} \ge \cores$ by induction. \qed
\end{proof}

The initial vector $\mathbf{c}^{(0)}[v] = \supp(v; G)$ trivially satisfies the upper-bound condition by Lemma~\ref{lem:supp}: a vertex's core value is at most its initial support.

\subsection{Closed-form H-index via CPI leaves}
\label{sec:local-cpi}

Computing $M_v(\mathbf{c})$ by enumerating $s$-cliques is infeasible. The \cpi{}'s leaf structure makes the H-index computable directly from the per-leaf binomial counts, without ever materializing a single $s$-clique.

\begin{lemma}[Per-leaf threshold contribution]
\label{lem:leaf-ge-k}
Fix a vertex $v$, a candidate vector c, and a threshold $k \ge 1$. For every leaf $P$ of the \cpi{} containing $v$, define
\[
  W_v(P, \mathbf{c}, k) \;:=\; \bigl|\{ C \text{ encoded by $P$} : v \in C,\ \mathbf{c}[u] \ge k\ \forall u \in C\setminus\{v\} \}\bigr|.
\]
Let $H_k(P) := |\{u \in \holdN{P} \setminus \{v\} : \mathbf{c}[u] \ge k\}|$ and $Q_k(P) := |\{u \in \pivN{P} \setminus \{v\} : \mathbf{c}[u] \ge k\}|$. Then:
\begin{itemize}[leftmargin=1.3em,itemsep=1pt,topsep=1pt]
  \item if $H_k(P) < |\holdN{P} \setminus \{v\}|$ (some other hold of $P$ fails the threshold): $W_v(P, \mathbf{c}, k) = 0$;
  \item else if $v \in \holdN{P}$: $\;W_v(P, \mathbf{c}, k) = \binom{Q_k(P)}{\eta_P}$;
  \item else (so $v \in \pivN{P}$): $\;W_v(P, \mathbf{c}, k) = \binom{Q_k(P)}{\eta_P - 1}$.
\end{itemize}
\end{lemma}

\begin{proof}
By Definition~\ref{def:leaf}, every clique encoded by $P$ has the form $\holdN{P} \cup P'$ with $P' \subseteq \pivN{P}$ and $|P'| = \eta_P$. Such a clique contains $v$ iff either $v \in \holdN{P}$ (always) or $v \in P'$. The threshold condition $\mathbf{c}[u] \ge k$ for every $u \in C \setminus \{v\}$ requires every other hold vertex of $P$ to satisfy $\mathbf{c} \ge k$ (giving the first bullet's vanishing case) and every pivot in $P'$ other than $v$ to satisfy $\mathbf{c} \ge k$. When $v \in \holdN{P}$, $P'$ is any size-$\eta_P$ subset of $\{u \in \pivN{P} : \mathbf{c}[u] \ge k\}$, of which there are $\binom{Q_k(P)}{\eta_P}$. When $v \in \pivN{P}$, $P'$ must additionally contain $v$, so $P' \setminus \{v\}$ is a size-$(\eta_P - 1)$ subset of $\{u \in \pivN{P} \setminus \{v\} : \mathbf{c}[u] \ge k\}$, of which there are $\binom{Q_k(P)}{\eta_P - 1}$. \qed
\end{proof}

The total threshold contribution at vertex $v$ is $W_v(\mathbf{c}, k) := \sum_{P \ni v} W_v(P, \mathbf{c}, k)$, and the H-index update is
\[
  h_v(\mathbf{c}) \;=\; \max\{k : W_v(\mathbf{c}, k) \ge k\}.
\]
A single $O(\deg_{\Sig}(v))$ scan over $v$'s leaf list, together with a bucket-style accumulation over the achievable $k$ levels (all distinct values of $\mathbf{c}[u]$ for $u$ on $v$'s leaves), computes $h_v$ in $O(\deg_{\Sig}(v) \log \deg_{\Sig}(v))$ time --- the log factor comes from sorting per-leaf thresholds, not from enumerating cliques.

\begin{algorithm}[t]
\caption{Local-iterative $(1,s)$-core (synchronous bulk-parallel).}
\label{alg:local}
\begin{algorithmic}[1]
\Require Graph $G$, parameter $s$, leaf-to-vertex CSR, vertex-to-leaf CSR, initial supports $\supp[\,]$.
\Ensure $\cores(v)$ for every $v \in V$.
\State $\mathbf{c}[v] \gets \supp[v]$ for all $v \in V$
\State \textit{changed} $\gets$ \textsc{true}
\While{\textit{changed}}
  \State \textit{changed} $\gets$ \textsc{false}
  \State $\mathbf{c}_{\text{new}} \gets \mathbf{c}$  \Comment{double-buffered, race-free}
  \For{each $v \in V$ \textbf{in parallel}}
    \State Compute $h_v$ via Lemma~\ref{lem:leaf-ge-k} from $\{\mathbf{c}[u] : u \in \text{leaves of } v\}$
    \If{$h_v < \mathbf{c}[v]$}
      \State $\mathbf{c}_{\text{new}}[v] \gets h_v$;\quad \textit{changed} $\gets$ \textsc{true}
    \EndIf
  \EndFor
  \State $\mathbf{c} \gets \mathbf{c}_{\text{new}}$
\EndWhile
\State \Return $\cores(v) \gets \mathbf{c}[v]$ for all $v$
\end{algorithmic}
\end{algorithm}

\subsection{Complexity and operating-point analysis}
\label{sec:local-cost}

\begin{theorem}[Local-iterative complexity]
\label{thm:local-cost}
Algorithm~\ref{alg:local} computes $\cores$ in $O(T \cdot \Sig \cdot \log d_{\max})$ work, where $T \le \kappa_{\max} + 1$ is the number of iterations until convergence and $d_{\max}$ is the maximum vertex leaf-degree (\S\ref{sec:prelim-cpi}).
\end{theorem}

\begin{proof}
Lemma~\ref{lem:hindex-fixedpt} bounds $T$. Each iteration evaluates $h_v$ for every $v$ at cost $O(\deg_{\Sig}(v) \log \deg_{\Sig}(v))$; the per-iteration work is $O(\Sig \log d_{\max})$. \qed
\end{proof}

On sequential hardware Algorithm~\ref{alg:local} performs $T$ full sweeps over $\Sig$ incidences, whereas the centralised peel of \S\ref{sec:peel} sweeps each incidence at most once; the peel is therefore $\Theta(T \log d_{\max})$ times faster in the worst case, and \S\ref{sec:exp-local} measures the gap empirically. The local algorithm is not presented as a single-thread improvement. Its value lies in the regimes that the centralised peel cannot serve. Because every per-vertex update reads only the vertex's leaf-mates and writes only the vertex itself, three deployment regimes are unlocked. (i)~\textit{Shared-memory parallel:} the loop on line~6 of Algorithm~\ref{alg:local} parallelises trivially across cores or GPU threads. (ii)~\textit{Distributed shared-nothing:} vertices are partitioned across machines, each machine stores the leaves intersecting its partition, and one iteration is a single all-to-all gather of changed values followed by local H-index updates~\cite{kcoreLocal}. (iii)~\textit{External memory:} each iteration is one streaming pass over the leaf list, with the candidate vector $O(n)$ in RAM; suitable when $\Sig$ exceeds RAM capacity. The centralised peel of \S\ref{sec:peel} achieves $O(\Sig)$ on a single thread but its guarantee rests on a sequential pop-min discipline that none of these regimes admit. The local algorithm is the foundation we leave for future shared-nothing implementations (\S\ref{sec:conclusion}).

%===============================================================
\section{Tree-Free CPI Construction}
\label{sec:treefree}

Both algorithms of \S\ref{sec:local} and \S\ref{sec:peel} consume the same three structures: a leaf-to-vertex CSR storing each leaf's hold and pivot sets, a vertex-to-leaf CSR mapping each vertex to the leaves it appears in, and an initial per-vertex support array. The CSR layout itself is textbook (compressed sparse row), and the visitor/callback pattern is a standard C++ idiom; what is novel here is the structural observation, enabled by Theorem~\ref{thm:immutable}, that for $r{=}1$ peeling never queries the parent--child structure of the \sdct{} tree. The tree therefore need not be materialised at all. We exploit this in a single-pass procedure (Algorithm~\ref{alg:build}) that builds all three structures in $O(\Sig)$ time and $O(\Sig)$ memory by routing each \sdct{} leaf through a callback at the moment of emission. The tree-free property is what is enabled by the invariant; the layout choices and the C++ callback machinery are off-the-shelf.

\subsection{The SDCT walk}
\label{sec:sdct}

The \textit{succinct degeneracy clique tree} (\sdct)~\cite{sigmodCPI} enumerates one \cpi{} leaf per recursive base case via a degeneracy-ordered Bron--Kerbosch search~\cite{bronkerbosch,eppstein} with Tomita pivoting~\cite{tomita}. The outer loop processes vertices in a degeneracy ordering; for each $v \in V$ the search begins with candidate set $P{=}N^{>}(v)$ (later neighbours of $v$) and exclusion set $X{=}N^{<}(v)$. Each recursion picks a pivot $u \in P$ maximising $|P \cap N(u)|$, branches over $\{u\} \cup (P \setminus N(u))$, and partitions every branched vertex into the hold set if it differs from the pivot or the drop set if it is the pivot. The recursion terminates with $P{=}\emptyset$, at which point the current $(\textit{keepV},\textit{dropV})$ pair is emitted as a leaf $(\holdN{P}, \pivN{P})$. Since each emitted leaf has size $|\holdN{P}| + |\pivN{P}|$ and recursion depth is bounded by the degeneracy, total enumeration work is $O(\Sig)$.

The baseline implementation~\cite{sigmodCPI} \textit{stores} the \sdct{} tree $\mathsf{T}$: each recursion node holds a \texttt{vector} of children together with its \textit{keepV}/\textit{dropV} suffixes. After enumeration, $\mathsf{T}$ is traversed twice to build the per-leaf hash sets $\mathsf{H}_P$ and the reverse vertex-to-leaf multimap. The tree itself is never read during peeling but consumes $\sim 8\Sig$ bytes plus per-node overhead, and the hash structures consume $\sim 80\Sig$ bytes (\S\ref{sec:csr}).

\subsection{Augmented enumeration with an onLeaf callback}
\label{sec:augsdct}

Theorem~\ref{thm:immutable} guarantees that peeling never queries the parent--child structure of $\mathsf{T}$; only per-leaf data is read. We therefore route every \sdct{} leaf through a callback at the moment of emission, before any tree node is stored:
\[
  \texttt{onLeaf}(\textit{leafId},\ \textit{keepV},\ \textit{dropV}).
\]
The callback writes the leaf into three flat structures simultaneously: the \textit{leaf-to-vertex} CSR (the contents of $\textit{keepV}$ and $\textit{dropV}$ are appended to two flat arrays, advancing the per-leaf offsets $\texttt{Vh\_off}$ and $\texttt{Vp\_off}$); the \textit{vertex-to-leaf} incidence counters ($\texttt{incCnt}[v]$ is incremented for every $v \in \textit{keepV} \cup \textit{dropV}$); and the initial per-vertex supports (by Lemma~\ref{lem:supp}, $\texttt{supp}[v]$ gains $\binom{|V_p|}{\eta}$ if $v \in \textit{keepV}$ or $\binom{|V_p|-1}{\eta-1}$ if $v \in \textit{dropV}$). A second linear pass after the walk converts $\texttt{incCnt}$ into the offset array $\texttt{rowOff}$ via prefix sum and re-walks the leaf-to-vertex CSR to fill the vertex-to-leaf array $\texttt{ent}$. Both passes are $O(\Sig)$. After this single enumeration and one CSR-fill pass, every data structure required by Algorithm~\ref{alg:local} and Algorithm~\ref{alg:peel} is in place; the \cpi{} tree is never allocated. Algorithm~\ref{alg:build} consolidates the procedure.

\begin{algorithm}[t]
\caption{Tree-free \cpi{} construction (augmented \sdct).}
\label{alg:build}
\begin{algorithmic}[1]
\Require Graph $G$ in degeneracy order, parameter $s$.
\Ensure Leaf-to-vertex CSR $(\texttt{Vh\_off}, \texttt{Vh\_ent}, \texttt{Vp\_off}, \texttt{Vp\_ent})$, vertex-to-leaf CSR $(\texttt{rowOff}, \texttt{ent})$, initial supports $\texttt{supp}[\,]$, leaf counter $L$.
\State $L \gets 0$;\quad $\texttt{incCnt}[v] \gets 0$, $\texttt{supp}[v] \gets 0$ for $v \in V$.
\For{$v$ in degeneracy order}
  \State $P \gets N^{>}(v)$;\quad $X \gets N^{<}(v)$
  \State \Call{BK}{$\{v\}, [\,], P, X$}
\EndFor
\State $\texttt{rowOff} \gets$ prefix-sum of $\texttt{incCnt}$
\State Re-walk leaves: for each leaf $P$, append $(P, \textsc{hold})$ to $\texttt{ent}[\texttt{rowOff}[v]++]$ for each $v \in \holdN{P}$, and $(P, \textsc{pivot})$ for $v \in \pivN{P}$
\Statex
\Procedure{BK}{$\textit{keepV}, \textit{dropV}, P, X$}
  \If{$P = \emptyset$}
    \If{$\textit{keepV} \neq \emptyset$ \textbf{and} $|\textit{keepV}| \le s \le |\textit{keepV}|+|\textit{dropV}|$}
      \State \Call{onLeaf}{$L$++, $\textit{keepV}, \textit{dropV}$}
    \EndIf
    \State \Return
  \EndIf
  \State $u \gets \arg\max_{w \in P}\, |P \cap N(w)|$  \Comment{Tomita pivot}
  \For{$c$ in $\{u\} \cup (P \setminus N(u))$}
    \State $P' \gets P \cap N(c)$;\quad $X' \gets X \cap N(c)$
    \If{$c = u$} \Call{BK}{$\textit{keepV},\, \textit{dropV} {+} [c],\, P', X'$}
    \Else \Call{BK}{$\textit{keepV} {+} [c],\, \textit{dropV},\, P', X'$}
    \EndIf
    \State $P \gets P \setminus \{c\}$;\quad $X \gets X \cup \{c\}$
  \EndFor
\EndProcedure
\Statex
\Procedure{onLeaf}{$\textit{id}, \textit{keepV}, \textit{dropV}$}
  \State $h \gets |\textit{keepV}|$;\quad $p \gets |\textit{dropV}|$;\quad $\eta \gets s - h$
  \State Append $\textit{keepV}$ to $\texttt{Vh\_ent}$, set $\texttt{Vh\_off}[\textit{id}{+}1]$;\ similarly $\texttt{Vp\_ent}$
  \For{$v \in \textit{keepV}$} $\texttt{incCnt}[v]\!\!+\!\!+$;\ \ $\texttt{supp}[v] \mathrel{+}= \binom{p}{\eta}$
  \EndFor
  \For{$v \in \textit{dropV}$} $\texttt{incCnt}[v]\!\!+\!\!+$;\ \ $\texttt{supp}[v] \mathrel{+}= \binom{p-1}{\eta-1}$
  \EndFor
\EndProcedure
\end{algorithmic}
\end{algorithm}

\subsection{Hash-free vertex--leaf CSR layout}
\label{sec:csr}

Compressed sparse row (CSR) is a textbook bipartite-incidence representation; the design choice exposed by Theorem~\ref{thm:immutable} is that we may use it \emph{statically} where the SOTA must use a mutable hash representation. Peeling accesses the \cpi--vertex bipartite incidence through a single operation: given a peeled vertex $v$, enumerate the leaves containing $v$ and the role of $v$ in each. Theorem~\ref{thm:immutable} guarantees this incidence never changes under peeling, so the layout can be both flat and static; the SOTA's hash representation is mandated by its mutable per-leaf vertex sets and reverse multimap. Our representation pays $4$ bytes per incidence, against the SOTA's $\sim 80$ bytes. Concretely, the CSR uses two arrays: \texttt{rowOff}$[v]$ of size $n+1$, giving the offset into \texttt{ent} where $v$'s incidence list begins, and \texttt{ent}$[k]$ of size $\Sig$, a packed $32$-bit word per incidence storing the leaf index in the low $31$ bits and the role (hold or pivot) in the high bit. Total memory is $4(n+1) + 4\Sig$ bytes, dominated by $4\Sig$ once $\Sig \gg n$.

The $20\times$ reduction over the SOTA arises as follows. The SOTA's per-leaf \texttt{unordered\_set<int>}, even after a perfect resize, costs $\ge 24$ bytes per inserted key (one node payload plus list pointer) plus a $\sim 30$\% load-factor slack, yielding $\approx 32$ bytes per key; combined with the reverse multimap at $\approx 48$ bytes per inserted pair, the per-incidence cost is $\approx 80$ bytes. Beyond memory, the CSR also wins on locality: a peeling step on $v$ scans the contiguous block $\texttt{ent}[\texttt{rowOff}[v]\,..\,\texttt{rowOff}[v+1])$, which fits in $\lceil \deg_{\Sig}(v)/16 \rceil$ cache lines and admits hardware prefetching, whereas the hash representation chases nodes scattered across the heap with one indirection per probe.

\subsection{Function-pointer trampoline}
\label{sec:trampoline}

The \sdct{} recursion can reach depths in the hundreds at large $s$; on \texttt{com-youtube} at $s{=}50$ the depth exceeds $200$. Templating the callback type forces every recursion frame to carry a closure: profiling shows \texttt{std::function} adds $32$ bytes per frame and triggers heap allocation for non-trivial captures, producing stack overflows on dense graphs. The standard C++ remedy is a function-pointer trampoline
$
\texttt{AugCtx} = \{\texttt{void* state},\ \texttt{void(*onLeaf)(void*, ...)}\},
$
fixed once at the top of the enumeration. Each leaf invocation costs an indirect call that the optimiser inlines reliably after profile-guided builds; recursion frames remain $16$ bytes plus the loop-local sets, and stack-buffer reuse keeps the live $P/X$ sets cache-resident. We adopt the trampoline with no further modification; this subsection records it for reproducibility rather than as a contribution.

\subsection{Memory budget}
\label{sec:treefree-mem}

Table~\ref{tab:mem} compares the dominant memory terms of the baseline and our pipeline at $\Sig \gg n$. The baseline's tree $\mathsf{T}$, per-leaf hash sets, and reverse hash multimap together account for $\approx 88$ bytes per incidence; the heap adds $24$ bytes per active vertex but is per-$n$, not per-$\Sig$. Our pipeline's dominant terms are the leaf-to-vertex flat arrays ($\sim 4\Sig$ bytes), the vertex-to-leaf CSR ($\sim 4\Sig$ bytes), and the support array plus bucket array ($O(n + \kappa_{\max})$ bytes), summing to $\approx 10$ bytes per incidence. The total Phase-1 (\sdct{} walk plus onLeaf) work is one $O(|\textit{keepV}|+|\textit{dropV}|)$ writeback per leaf, summing to $O(\Sig)$ on top of the bare \sdct{} cost; Phase 2 (prefix sum plus CSR fill) is two linear passes. Construction is therefore $O(\sdct_{\text{cost}} + \Sig)$, asymptotically equal to the baseline's tree-walk cost; in practice the absence of per-node tree allocations and hash-set inserts contributes a substantial constant-factor improvement included in the end-to-end timings of \S\ref{sec:exp}.

\begin{table}[t]
\centering
\caption{Memory budget per vertex--leaf incidence at $\Sig \gg n$. Baseline numbers from the SOTA implementation~\cite{sigmodCPI}; our numbers are sizeofs of the C++ data structures used in \S\ref{sec:exp}.}
\label{tab:mem}
\small
\begin{tabular}{lrr}
\toprule
\textbf{Component} & \textbf{Baseline} & \textbf{Ours} \\
\midrule
\cpi{} tree $\mathsf{T}$ (children + flags + spans) & $8\Sig$ & $0$ \\
Leaf-to-vertex storage ($\holdN{}, \pivN{}$ flat) & $0$ & $4\Sig$ \\
Per-leaf vertex set $\mathsf{H}_P$ (hash) & $32\Sig$ & --- \\
Reverse vertex-to-leaf map (hash) & $48\Sig$ & --- \\
Vertex-to-leaf CSR ($\texttt{rowOff}+\texttt{ent}$) & --- & $4\Sig$ \\
Support array $\texttt{supp}[\,]$ & $4n$ & $4n$ \\
Heap $\mathsf{Q}$ / bucket array $B[\,]$ & $24n$ & $16n + 8\kappa_{\max}$ \\
\midrule
\textbf{Dominant total} (per incidence) & $\approx 88\Sig$ & $\approx 10\Sig$ \\
\bottomrule
\end{tabular}
\end{table}

%===============================================================
\section{Centralized Peeling}
\label{sec:peel}

Given the data structures built by Algorithm~\ref{alg:build}, this section presents the centralised peel: a single-thread $O(\Sig)$ algorithm that processes vertices in increasing-support order and broadcasts deltas through the static CSR of \S\ref{sec:csr}. Theorem~\ref{thm:immutable} and Lemma~\ref{lem:delta} guarantee that every broadcast is closed-form integer arithmetic on a single per-leaf counter. With the incidence layout fixed, the standard bucket-queue peeling discipline of $k$-core~\cite{coreAlg,bucketQueue} applies directly (\S\ref{sec:bucket}); the SOTA's $\Theta(\log n)$ decrease-key on a binary heap, mandated by its mutable hash representation, is therefore avoidable. The contribution of this section is not the bucket queue itself --- a classical technique --- but the observation that the immutability invariant is what makes a static CSR layout possible, after which the bucket queue follows as a standard step. On a single thread the resulting peel runs $T$ to $T \log d_{\max}$ times faster than the local algorithm of \S\ref{sec:local}, where $T$ is the H-index iteration count of Theorem~\ref{thm:local-cost} and ranges from a few dozen to a few thousand on the configurations we evaluate.

\subsection{Bucket-based priority queue}
\label{sec:bucket}

The peeling loop pops the vertex of currently minimum support, and the support level $k$ is monotone non-decreasing as peeling proceeds. The SOTA implementation uses a binary heap $\mathsf{Q}$ at $\Theta(\log n)$ per decrease-key. Two properties of the peeling pattern admit a constant-time alternative~\cite{coreAlg,bucketQueue}: supports are non-negative integers bounded by $\kappa_{\max}$ (\S\ref{sec:prelim-cpi}), and only decrements occur. We maintain an array of doubly-linked lists $B[0\,..\,\kappa_{\max}]$, where $B[x]$ chains every vertex whose current support equals $x$. Each vertex stores a back-pointer to its node within $B[x]$, enabling $O(1)$ unlink. A support drop from $x$ to $x - \Delta$ is $O(1)$: unlink from $B[x]$, push to $B[x-\Delta]$. A monotone cursor $k$ scans $B[\,]$ upward: while $B[k]$ is empty, $k$ advances; otherwise the front of $B[k]$ is popped as the next victim. The cursor advances at most $\kappa_{\max}$ times across the entire peeling. The bucket array uses $O(n + \kappa_{\max})$ words; in our implementation $\kappa_{\max}$ never exceeds the $s$-clique count and is typically much smaller, e.g.\ below $10^5$ on \texttt{com-youtube} at $s{=}10$ where $\Sig \approx 10^9$.

Algorithm~\ref{alg:peel} consolidates Theorem~\ref{thm:immutable}, Lemma~\ref{lem:delta}, the static CSR (\S\ref{sec:csr}), and the bucket queue into a single peeling routine.

\begin{algorithm}[t]
\caption{Immutable-\cpi{} peeling for $(1,s)$-nucleus decomposition.}
\label{alg:peel}
\begin{algorithmic}[1]
\Require Graph $G$, parameter $s$, \cpi{} $\mathcal{P}$ as $(\holdN{P}, \pivN{P})$ for each $P$, vertex--leaf CSR $(\texttt{rowOff}, \texttt{ent})$.
\Ensure $\cores(v)$ for every $v \in V$.
\State \textbf{Init counters:} for each $P \in \mathcal{P}$, set $p_P \gets |\pivN{P}|$, $\eta_P \gets s - |\holdN{P}|$, $\textit{alive}_P \gets (p_P \ge \eta_P)$.
\State \textbf{Init supports:} for each $v \in V$, $\supp[v] \gets \sum_{P \ni v} \text{contrib}(v, P)$ via Lemma~\ref{lem:supp}; insert $v$ into bucket $B[\supp[v]]$.
\State $k \gets 0$
\For{$\textit{round} = 1, \ldots, n$}
  \While{$B[k]$ is empty} $k \gets k + 1$
  \EndWhile
  \State $v \gets$ pop front of $B[k]$;\quad $\cores(v) \gets k$
  \For{each $(P, \textit{role})$ in $\texttt{ent}[\texttt{rowOff}[v]\,..\,\texttt{rowOff}[v{+}1])$}
    \If{$\neg \textit{alive}_P$} \textbf{continue}
    \EndIf
    \If{$\textit{role} = \textsc{hold}$}  \Comment{Case A}
      \State $\Delta_h \gets \binom{p_P}{\eta_P}$;\quad $\Delta_p \gets \binom{p_P{-}1}{\eta_P{-}1}$
      \State \textsc{Broadcast}$(P, v, \Delta_h, \Delta_p)$;\quad $\textit{alive}_P \gets \textsc{false}$
    \Else \Comment{$\textit{role} = \textsc{pivot}$}
      \State $p' \gets p_P - 1$
      \If{$p' < \eta_P$} \Comment{Case C$'$}
        \State $\Delta_h \gets \binom{p_P}{\eta_P}$;\quad $\Delta_p \gets \binom{p_P{-}1}{\eta_P{-}1}$
        \State \textsc{Broadcast}$(P, v, \Delta_h, \Delta_p)$;\quad $\textit{alive}_P \gets \textsc{false}$
      \Else \Comment{Case C}
        \State $\Delta_h \gets \binom{p_P}{\eta_P} - \binom{p'}{\eta_P}$
        \State $\Delta_p \gets \binom{p_P{-}1}{\eta_P{-}1} - \binom{p'{-}1}{\eta_P{-}1}$
        \State \textsc{Broadcast}$(P, v, \Delta_h, \Delta_p)$;\quad $p_P \gets p'$
      \EndIf
    \EndIf
  \EndFor
\EndFor
\Statex
\Procedure{Broadcast}{$P$, $v$, $\Delta_h$, $\Delta_p$}
  \For{each $u$ in $\holdN{P} \cup \pivN{P}$, $u \ne v$, $u$ not yet peeled}
    \State $\Delta \gets \Delta_h$ if $u \in \holdN{P}$ else $\Delta_p$
    \State $\supp[u] \gets \supp[u] - \Delta$;\quad \textsc{ReBucket}($u$)
  \EndFor
\EndProcedure
\end{algorithmic}
\end{algorithm}

\subsection{Algorithm walk-through and complexity}
\label{sec:immutable-cost}

\begin{example}
\label{ex:peel-walkthrough}
We trace Algorithm~\ref{alg:peel} on the running example. The initial supports computed by Lemma~\ref{lem:supp} are $(\supp[v_1], \ldots, \supp[v_{10}]) = (3, 4, 6, 6, 3, 4, 1, 1, 1, 1)$, so $B[1]$ initially holds $\{v_7, v_8, v_9, v_{10}\}$ and the cursor starts at $k{=}1$. Round~$1$ pops $v_8$; its CSR row contains $(L_1, \textsc{pivot})$, and the pivot branch with $p_{L_1}{=}2$, $\eta{=}2$ produces $p'{=}1 < \eta$, triggering Case~C$'$: $L_1$ dies, $\Delta_h{=}\Delta_p{=}1$ are broadcast to $v_6$ and $v_7$. Round~$2$ pops $v_7$ at $k{=}1$; its only incidence is the now-dead $L_1$ and the row is skipped. Rounds~$3$--$4$ symmetrically dispatch $L_2$. After Round~$4$ the cursor advances to $k{=}3$, and Rounds~$5$--$10$ peel the $K_4$-block vertices in the order $v_2, v_1, v_4, v_5, v_3, v_6$, mixing the Case-C events ($v_2$ on $L_3$, $v_4$ on $L_5$) with Case-A events (each block-leaf hold) and a closing Case~C$'$ on $L_5$. Throughout, only six pivot counters (each touched at most once), six liveness flags, ten support entries, and the bucket pointers are written; the leaf sets $(\holdN{P}, \pivN{P})$ are read but never modified.
\end{example}

The complexity follows by amortising the bucket scan and the broadcast work over $\Sig$. Let $U$ denote the total number of \textsc{Broadcast} delta applications across the entire run.

\begin{theorem}[Peeling complexity]
\label{thm:complexity}
Algorithm~\ref{alg:peel} runs in $O(\Sig + U + \kappa_{\max} + n)$ time, where $\Sig$ is the \cpi{}'s vertex--leaf incidence count and $\kappa_{\max}$ is the maximum support (\S\ref{sec:prelim-cpi}). The SOTA heap-based loop~\cite{sigmodCPI} performs the same number of broadcasts $U$ but at a $\Theta(\log n)$ factor per broadcast, giving $O(\Sig + U \log n)$.
\end{theorem}

\begin{proof}
The bucket cursor advances at most $\kappa_{\max}$ times across the run. The CSR scan visits each incidence $(v, P)$ exactly once (when $v$ is peeled), contributing $O(\Sig)$ across the whole run; the dead-leaf check rejects most visits in $O(1)$. Each surviving $(v, P)$ visit dispatches a \textsc{Broadcast} costing $O(|\holdN{P}| + p_P)$, summed across the run as $U$ delta applications. Each application is an integer subtract followed by an $O(1)$ bucket relocation, contributing $O(U)$ in total. Summing the four terms yields $O(\Sig + U + \kappa_{\max} + n)$. The heap baseline replaces the $O(1)$ relocation with a $\Theta(\log n)$ decrease-key. \qed
\end{proof}

In all configurations we evaluate, $U = O(\Sig)$: a leaf $P$ contributes at most $|\pivN{P}| - \eta_P + 1$ broadcasts (one per Case-C event plus one terminal Case-A or C$'$), each touching at most $|\holdN{P}| + p_P$ vertices. We measure $U / \Sig \in [1.0, 4.5]$ across the $762$ configurations of \S\ref{sec:exp}. Theorem~\ref{thm:complexity} then simplifies to $O(\Sig)$ for our peel against $O(\Sig \log n)$ for the heap baseline.

\subsection{Hierarchy as a peel byproduct}
\label{sec:peel-hier}

The bucket-queue peel produces vertices in non-decreasing $(1,s)$-core order, the natural input order of any persistent-homology join-tree algorithm~\cite{morozov2007persistence}. Combined with the CSR immutability of Theorem~\ref{thm:immutable}, this means the connectivity hierarchy of the super-level filtration $\{V_k\}_k$, $V_k {=} \{v : \cores(v) {\ge} k\}$, is recoverable from the peel deletion log without an additional sort phase, at the cost of one union-find operation per surviving edge.

\begin{theorem}[Hierarchy as a peel byproduct]
\label{thm:peel-hier}
Let $L = (v_1, k_1), \ldots, (v_n, k_n)$ be the deletion log of Algorithm~\ref{alg:peel}, with $k_1 {\le} k_2 {\le} \cdots {\le} k_n$.  Then the elder-rule join tree of the super-level filtration $\{V_k\}_k$ over the connectivity graph $G$ can be computed by a single reverse pass over $L$ with union-find on the static CSR of \S\ref{sec:csr}, in $O((n{+}m)\,\alpha(n))$ time on top of Algorithm~\ref{alg:peel} and without an additional sort phase.
\end{theorem}

\begin{proof}
We exhibit the reverse pass.  Initialise an empty union-find $\mathit{UF}$ over the vertex set $V$ and an empty branch table $H$ mapping each $\mathit{UF}$-root to its currently-living branch.  Walk $L$ from $t = n$ down to $t = 1$.  At step $t$, let $v_t$ have core $k_t$ and let $N(v_t)$ be the original neighbour set of $v_t$ in $G$.  Define the \emph{already-processed neighbours} as $N^+(v_t) = \{u \in N(v_t) : \text{$u$ already inserted into }\mathit{UF}\}$, equivalently $\{u \in N(v_t) : k(u) \ge k_t\}$ since we walk in non-increasing $k$.  Insert $v_t$ into $\mathit{UF}$ as a new singleton, then for each $u \in N^+(v_t)$ call $\mathit{UF.union}(v_t, u)$, applying the elder rule on $H$ to record persistence pairs as in any textbook join-tree construction~\cite{morozov2007persistence}: the elder of the two roots survives, the younger root receives $k_\mathrm{death}{=}k_t$.  After the pass, each branch $b$ has a complete $(k_\mathrm{birth}, k_\mathrm{death})$ pair (roots get $k_\mathrm{death}{=}0$).

Two correctness ingredients matter.  First, $L$ is in non-increasing $k$ when reversed because Algorithm~\ref{alg:peel}'s bucket queue produces vertices in non-decreasing $k$ as a structural invariant of the bucket cursor (\S\ref{sec:bucket}); no separate sort is needed.  Second, $N(v_t)$ is queried via the same edge iterator that Algorithm~\ref{alg:peel} uses for delta broadcasts.  Theorem~\ref{thm:immutable} guarantees that the CSR built by Algorithm~\ref{alg:build} is unchanged by peeling, so the iterator dereferences exactly the same memory the peel just used --- no auxiliary edge index is needed and no race condition with tree edits exists.

Cost: each vertex is inserted into $\mathit{UF}$ once ($n$ operations); each edge of $G$ contributes at most two $\mathit{UF.union}$ calls (once when the lower-$k$ endpoint is processed and finds the higher-$k$ endpoint already present, once symmetrically if $k$'s tie); branch bookkeeping is $O(1)$ per insert.  Total: $O((n{+}m) \alpha(n))$.  Combined with Algorithm~\ref{alg:peel}'s $O(\Sig)$ time, the joint peel-plus-hierarchy pipeline costs $O(\Sig + (n{+}m)\alpha(n))$, asymptotically the same as peel alone since $\Sig \ge m$ in any non-trivial $(1,s)$ instance.  \qed
\end{proof}

The contribution is structural rather than asymptotic: the elder-rule join-tree algorithm is textbook~\cite{morozov2007persistence}.  What is $(1,s)$-specific is the interleaving with peel.  For $r {\ge} 2$ the SOTA peel mutates the CPI tree~\cite{sigmodCPI}, so concurrent hierarchy extraction would race against tree edits --- the integration is uniquely available at $r{=}1$, where Theorem~\ref{thm:immutable} freezes the CSR layout.  \S\ref{sec:cs-hier} evaluates the construction empirically against a stand-alone elder-rule baseline; eliminating the explicit sort yields a $5$--$10\%$ wall-clock saving in our reference Python implementation, and the structural benefit is that the same CSR backs both peel and hierarchy.

\stitle{Hooking into Algorithm~\ref{alg:peel}.}
The reverse pass is appended to Algorithm~\ref{alg:peel} as follows.  Each successful pop from $\mathit{popMin}$ in line~3 emits one $(v_t, k_t)$ row to a contiguous deletion-log array (\texttt{O(1)} append; reuses the bucket-queue's existing iteration order, no extra data structure).  After the bucket loop terminates the procedure walks the array in reverse and applies the proof's union-find loop in-place over the same CSR.  No line of Algorithm~\ref{alg:peel} other than the deletion-log append is added.

%===============================================================
\section{Performance Evaluation}
\label{sec:exp}

This section reports the end-to-end performance of the centralised peel of \S\ref{sec:peel} against the SOTA $(r,s)$-decomposition algorithm of~\cite{sigmodCPI}. Section~\ref{sec:exp-setup} fixes the experimental setup; Section~\ref{sec:exp-speed} reports speedup and memory results across $762$ $(graph, s)$ configurations on ten large graphs; Section~\ref{sec:exp-breakdown} dissects the time and memory cost by phase; Section~\ref{sec:exp-bd} closes with a per-graph breakdown.

\subsection{Experimental setup}
\label{sec:exp-setup}

\stitle{Hardware and software.}
All experiments run on a single dual-socket Intel Xeon Gold $6248R$ ($24$ cores, $503$ GB DDR4) under Ubuntu $22.04$. Code is compiled with Clang $18.1$ at \texttt{-O3 -march=native}, linked against TBB $2021.10$, Boost $1.83$, and \texttt{robin\_hood::unordered\_flat\_map}. Both implementations are single-threaded for these measurements; wall-clock and resident-set numbers are averaged over three runs.

\stitle{Datasets.}
Table~\ref{tab:datasets} lists the ten graphs used for the main evaluation. The set spans four orders of magnitude in $|E|$ (from $0.9$M edges on \texttt{com-amazon} to $117$M edges on \texttt{com-orkut}) and four structural regimes (collaboration, e-commerce, social, web). All graphs are publicly available from SNAP~\cite{communityFinder} or the LAW collection. The maximum $s$ tested per graph is bounded above by the graph's degeneracy plus one and below by available memory; we record $s$ ranges sufficient to cover both the small-$s$ and the large-$s$ regimes of \S\ref{sec:exp-speed}.

\begin{table}[t]
\centering
\caption{Datasets used in \S\ref{sec:exp}. $|V|$ is in vertices, $|E|$ in edges. $s$-range gives the values of $s$ exercised in the benchmark; the upper bound is either the graph's degeneracy plus one or the largest $s$ at which the SOTA's working set fits in the machine's $503$ GB of RAM.}
\label{tab:datasets}
\small
\begin{tabular}{lrrcr}
\toprule
Graph                                & $|V|$            & $|E|$               & $s$-range  & \#~$(g,s)$ \\
\midrule
