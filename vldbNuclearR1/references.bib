@inproceedings{apply_cyber,
author = {Matalobos Veiga, Juan Manuel and Criado, Regino and Romance Del Rio, Miguel and Iglesias Perez, Sergio and Partida Rodriguez, Alberto and Hanumanthappa Manjunatha, Karan Kabbur},
title = {A Hypergraph-based Model for Cyberincident-related Data Analysis},
year = {2024},
isbn = {9798400716515},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3655693.3661300},
doi = {10.1145/3655693.3661300},
abstract = {The Threat Intelligence discipline provides cyberdefenders with a high amount of information related to techniques, tactics and procedures involved in known cyberincidents. This information is key for the definition of a sound cybersecurity strategy, through a thorough process of risk analysis. The increasing amount of information available about known adversaries, campaigns, attacks, techniques, tactics, procedures and tools, among others, related to known cyberincidents makes it difficult to analyze and obtain useful conclusions that can be applicable to the cybersecurity strategy. Processing this information without automation leads to lack of escalability and introduction of biases and inconsistencies due to the participation of different experts with different criteria and background. The availability of a similarity measure between different cyberincidents based on their related data can be useful in this context, both increasing the efficiency identifying the cyberincidents whose analysis can provide more information, because of their dissimilitude and increasing the quality of the conclusions providing quantitative information in trends. In order to automate the processing of threat intelligence information, graphs theory can provide the capability of graphs to model and manipulate high quantities of heterogeneous data with complex relationships among them. For the definition of the similarity measure, hypergraphs can be used to model this high amount of complex and heterogeneous information along with the complex relationships between the different pieces of data, such as techniques used in attacks against banks or adversaries operating in 2023. All items related to a certain cyberincident, like adversaries, used techniques and so on, can be modelled using a hypergraphs whose nodes define the attributes that the item can or cannot have. The items related to different incidents will define different hyperedges depending on their attributes. With the model properly established, the mathematical tools available to operate with hypergraphs can be used to obtain actionable information. There are multiple similarity measures defined over hypergraphs that can be used in isolation or in combination in order to obtain similarity measures in different ways to respond to different questions like what are the techniques that have started to be used against a certain target or how similar are the attacks performed by two adversaries that can threaten a certain company.},
booktitle = {Proceedings of the 2024 European Interdisciplinary Cybersecurity Conference},
pages = {161–162},
numpages = {2},
keywords = {cyberincident, cybersecurity, higher degree graph, hypergraph, threat intelligence},
location = {Xanthi, Greece},
series = {EICC '24}
}

@article{e-shipping_recommendation,
 abstract = {Recommender systems are emerging in e-commerce as important promotion tools to assist customers to discover potentially interesting items. Currently, most of these are single-objective and search for items that fit the overall preference of a particular user. In real applications, such as restaurant recommendations, however, users often have multiple objectives such as group preferences and restaurant ambiance. This paper highlights the need for multi-objective recommendations and provides a solution using hypergraph ranking. A general User–Item–Attribute–Context data model is proposed to summarize different information resources and high-order relationships for the construction of a multipartite hypergraph. This study develops an improved balanced hypergraph ranking method to rank different types of objects in hypergraph data. An overall framework is then proposed as a guideline for the implementation of multi-objective recommender systems. Empirical experiments are conducted with the dataset from a review site Yelp.com, and the outcomes demonstrate that the proposed model performs very well for multi-objective recommendations. The experiments also demonstrate that this framework is still compatible for traditional single-objective recommendations and can improve accuracy significantly. In conclusion, the proposed multi-objective recommendation framework is able to handle complex and changing demands for e-commerce customers.},
 author = {Mingsong Mao and Jie Lu and Jialin Han and Guangquan Zhang},
 doi = {10.1016/j.ins.2018.07.029},
 issn = {0020-0255},
 journal = {Information Sciences},
 keywords = {Recommender systems, E-commerce, User personalization, Hypergraph},
 pages = {269--287},
 title = {Multiobjective e-commerce recommendations based on hypergraph ranking},
 url = {https://www.sciencedirect.com/science/article/pii/S0020025518305437},
 volume = {471},
 year = {2019}
}


